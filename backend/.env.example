# Подключение к базе данных (совпадает с docker-compose.yml)
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# Настройки JWT (авторизации)
JWT_SECRET="super-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# Порт бэкенда
PORT=3000

# Адрес фронтенда (чтобы браузер не ругался на CORS)
CORS_ORIGIN="http://localhost:8080"